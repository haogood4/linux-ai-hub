---
interface Props {
  title: string;
  subtitle?: string;
  breadcrumb?: string;
}
const { title, subtitle, breadcrumb } = Astro.props as Props;
---
<section class="bg-white border-b border-gray-200">
  <div class="max-w-4xl mx-auto px-4 py-12 md:py-16">
    {breadcrumb && (
      <nav aria-label="面包屑" class="text-sm text-gray-500 mb-3">
        <a href="/" class="hover:text-primary no-underline underline underline-offset-4 decoration-gray-400">首页</a>
        <span aria-hidden="true"> / </span>
        <span class="text-gray-700">{breadcrumb}</span>
      </nav>
    )}
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">{title}</h1>
    {subtitle && <p class="text-lg text-gray-600 max-w-2xl">{subtitle}</p>}
  </div>
</section>