---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection } from 'astro:content';

const paths = (await getCollection('paths')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="学习路径：从零开始玩转 Linux + AI | TuxAI"
  description="按阶段规划的学习路径：入门、进阶、AI 实践三档，把本站教程与指南串成一条可执行的成长路线。"
>
  <PageHeader
    breadcrumb="学习路径"
    title="学习路径"
    subtitle="不知道自己该从哪开始？按这三档路线走即可。每一档都串起了本站对应的教程与指南，完成一档再进入下一档。"
  />

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="space-y-10">
      {paths.map((p) => (
        <section aria-labelledby={`path-${p.slug}`} class="rounded-xl border border-gray-200 bg-white p-6 md:p-8">
          <div class="flex flex-wrap items-baseline gap-3 mb-1">
            <h2 id={`path-${p.slug}`} class="text-2xl font-bold">{p.data.title}</h2>
            <span class="text-sm text-gray-500">预计 {p.data.duration}</span>
          </div>
          <p class="text-gray-600 mb-2"><strong class="text-gray-800">目标：</strong>{p.data.goal}</p>
          <p class="text-sm text-gray-500 mb-6">适合：{p.data.audience}</p>

          <ol class="space-y-3">
            {p.data.steps.map((s, i) => (
              <li class="flex gap-4">
                <span aria-hidden="true" class="shrink-0 mt-0.5 flex h-6 w-6 items-center justify-center rounded-full bg-primary/10 text-primary text-xs font-bold">
                  {i + 1}
                </span>
                <div>
                  <a href={s.href} class="font-medium text-primary hover:underline no-underline">{s.label}</a>
                  <p class="text-sm text-gray-500">{s.note}</p>
                </div>
              </li>
            ))}
          </ol>

          <p class="mt-6 text-sm text-gray-500">{p.body}</p>
        </section>
      ))}
    </div>

    <p class="mt-10 text-sm text-gray-500">
      提示：学习路径会随教程库更新而调整。涉及安装与分区的步骤，请务必先备份重要数据。
    </p>
  </div>
</BaseLayout>