---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorials-en')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<BaseLayout
  title="Tutorials (EN) | TuxAI"
  description="English tutorials for Linux + AI: local TTS and local video generation with Wan 2.2. Pilot English content, more coming."
>
  <PageHeader
    breadcrumb="EN"
    title="Tutorials (English)"
    subtitle="Pilot English translations of the Linux + AI tutorial library. Two guides for now — the rest of the library is available in Chinese."
  />
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h2 class="text-xl font-bold mb-4">Available in English</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {tutorials.map((t) => (
        <a href={`/en/tutorials/${t.slug}`} class="block rounded-xl border border-gray-200 bg-white p-6 hover:shadow-md transition-shadow no-underline">
          <h3 class="font-semibold text-gray-900 mb-2 leading-snug">{t.data.title}</h3>
          <p class="text-sm text-gray-600 mb-4">
            {t.data.tags.map((tag) => (
              <span class="inline-block rounded-full bg-gray-100 text-gray-600 px-2.5 py-0.5 text-xs mr-1.5 mb-1">{tag}</span>
            ))}
          </p>
          <p class="text-xs text-gray-500">
            {t.data.estimatedReadTime} min read ·{' '}
            {t.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
        </a>
      ))}
    </div>

    <h2 class="text-xl font-bold mt-12 mb-4">More tutorials</h2>
    <p class="text-sm text-gray-600 mb-4">
      The full library (13 guides, Chinese) covers Linux basics, Ollama, vLLM, RAG, Dify, ComfyUI, Function Calling &amp; MCP and more.
    </p>
    <a href="/tutorials" class="inline-block rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-medium text-gray-700 no-underline hover:bg-gray-100 transition-colors">
      ← Browse the Chinese tutorial hub
    </a>
  </div>
</BaseLayout>
