---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorials')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const plannedGroups = [
  {
    title: 'AI 应用开发',
    items: [
      { title: 'Function Calling 与 MCP', desc: '让本地模型调用工具，连接外部系统' },
    ],
  },
  {
    title: '更多生图与创作',
    items: [
      { title: 'ComfyUI 工作流入门', desc: '节点式工作流进阶，复刻社区成熟方案' },
      { title: 'AI 视频生成', desc: '本地视频生成与工作流集成' },
      { title: '语音合成（TTS）本地部署', desc: '本地文字转语音服务' },
    ],
  },
];
---
<BaseLayout
  title="Linux + AI 教程库 | TuxAI"
  description="从 Linux 入门到 AI 本地部署的教程合集：安装、命令行、Ollama、GPU 推理、Docker 等可复现的实践指南。"
>
  <PageHeader
    breadcrumb="内容"
    title="教程库"
    subtitle="可跟着做的实践教程：Linux 入门、系统配置、AI 部署与工具链。每篇都有明确的环境要求与操作步骤。"
  />
  <div class="max-w-4xl mx-auto px-4 py-12">
    <a href="/terminal-game" class="block rounded-xl border-2 border-dashed border-green-600/50 bg-green-50/50 p-5 mb-8 hover:bg-green-50 transition-colors no-underline">
      <p class="font-semibold text-green-800 mb-1">先玩再学：包管理器命令行闯关游戏</p>
      <p class="text-sm text-green-700">分三个独立关卡：Debian 系 apt、Arch 系 pacman、Red Hat 系 dnf，一次只学一派不混淆。命令对照表与游戏同页。</p>
    </a>
    {tutorials.length > 0 && (
      <>
        <h2 class="text-xl font-bold mb-4">已上线</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {tutorials.map((t) => (
            <a href={`/tutorials/${t.slug}`} class="block rounded-xl border border-gray-200 bg-white p-6 hover:shadow-md transition-shadow no-underline">
              <h3 class="font-semibold text-gray-900 mb-2 leading-snug">{t.data.title}</h3>
              <p class="text-sm text-gray-600 mb-4">
                {t.data.tags.map((tag) => (
                  <span class="inline-block rounded-full bg-gray-100 text-gray-600 px-2.5 py-0.5 text-xs mr-1.5 mb-1">{tag}</span>
                ))}
              </p>
              <p class="text-xs text-gray-500">
                预计阅读 {t.data.estimatedReadTime} 分钟 ·{' '}
                {t.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
            </a>
          ))}
        </div>
      </>
    )}

    <h2 class="text-xl font-bold mt-12 mb-4">规划中</h2>
    <p class="text-sm text-gray-500 mb-6">
      以下教程已列入计划，内容撰写中，上线后会同步到学习路径。你可以先收藏本站，或到
      <a href="/community" class="text-primary underline underline-offset-2 hover:opacity-80">社区入口</a> 获取更新。
    </p>
    <div class="space-y-8">
      {plannedGroups.map((g) => (
        <section>
          <h3 class="font-semibold text-gray-800 mb-3">{g.title}</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {g.items.map((item) => (
              <div class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6" aria-disabled="true">
                <div class="flex items-start justify-between gap-3 mb-2">
                  <h4 class="font-medium text-gray-700 leading-snug">{item.title}</h4>
                  <span class="shrink-0 rounded-full bg-gray-200 text-gray-600 px-2.5 py-0.5 text-xs whitespace-nowrap">规划中</span>
                </div>
                <p class="text-sm text-gray-500">{item.desc}</p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>