---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getCollection } from 'astro:content';

const tools = (await getCollection('tools')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'zh'));

const categories = ['AI 工具', '开发工具', '创作设计', '办公效率'];
---
<BaseLayout
  title="Linux 工具评测：AI、开发、创作一站式清单 | TuxAI"
  description="精选 Linux 上的高质量工具：AI 推理、开发、创作与办公四类，含开源许可、平台支持与官方入口。"
>
  <PageHeader
    breadcrumb="工具"
    title="工具评测"
    subtitle="精选 Linux 生态里值得先装的高质量工具，按用途分类。每条都提供官方入口与一句话评价——不堆参数，只讲好不好用。"
  />
  <div class="max-w-5xl mx-auto px-4 py-12">
    <div class="space-y-12">
      {categories.map((cat) => {
        const items = tools.filter((t) => t.data.category === cat);
        if (items.length === 0) return null;
        return (
          <section aria-labelledby={`cat-${cat}`}>
            <h2 id={`cat-${cat}`} class="text-2xl font-bold mb-4">{cat}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {items.map((t) => (
                <div class="rounded-xl border border-gray-200 bg-white p-6 flex flex-col">
                  <div class="flex items-start justify-between gap-3 mb-2">
                    <h3 class="font-semibold text-gray-900">
                      <a href={`/tools/${t.slug}`} class="hover:text-primary no-underline">{t.data.name}</a>
                    </h3>
                    <span class="shrink-0 rounded-full bg-gray-100 text-gray-600 px-2.5 py-0.5 text-xs whitespace-nowrap">{t.data.license}</span>
                  </div>
                  <p class="text-sm text-gray-600 flex-1">{t.data.description}</p>
                  <p class="text-xs text-gray-400 mt-3">
                    平台：{t.data.platforms.join(' / ')}
                    <span aria-hidden="true"> · </span>
                    <a href={t.data.officialUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline no-underline">
                      官网 <span aria-hidden="true">↗</span>
                    </a>
                  </p>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <p class="mt-12 text-sm text-gray-500">
      清单持续更新。工具描述基于公开信息与常见使用体验，具体功能与许可请以官网为准。
    </p>
  </div>
</BaseLayout>