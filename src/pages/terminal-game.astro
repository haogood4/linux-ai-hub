---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';

// 题库：{ q, accept: string[]（可接受命令，判定前自动去除 sudo/-y/多余空格）, explain: 答错时的讲解 }
const questions = [
  {
    q: '在 Ubuntu 上安装 git（提示：Ubuntu 属于 Debian 系，用 apt）',
    accept: ['apt install git'],
    explain: 'Ubuntu 用 apt：sudo apt install git。Debian 系（Debian、Ubuntu、Mint、Pop!_OS）都认 apt。',
  },
  {
    q: '在 Fedora 上安装 git（提示：Fedora 属于 Red Hat 系，用 dnf）',
    accept: ['dnf install git'],
    explain: 'Fedora 用 dnf：sudo dnf install git。Red Hat 系（Fedora、RHEL、Rocky）都是 dnf（旧版 yum）。',
  },
  {
    q: '在 Arch Linux 上安装 git（提示：Arch 系用 pacman，短参数风格）',
    accept: ['pacman -s git', 'pacman -sy git', 'pacman install git'],
    explain: 'Arch 用 pacman：sudo pacman -S git。注意是 -S（大写），pacman 的参数风格和 apt/dnf 完全不同。',
  },
  {
    q: '在 Debian 上搜索包 ffmpeg',
    accept: ['apt search ffmpeg'],
    explain: '搜索用 search：apt search ffmpeg。Debian 系通用。',
  },
  {
    q: '在 Ubuntu 上更新软件索引（不升级软件，只刷新软件列表）',
    accept: ['apt update'],
    explain: '更新索引：sudo apt update。注意 update 只是刷新索引，升级软件要用 upgrade——这是新手最容易混的两条命令。',
  },
  {
    q: '在 Arch Linux 上把整个系统更新到最新',
    accept: ['pacman -syu'],
    explain: 'Arch 一条命令搞定：sudo pacman -Syu（-S 安装、-y 刷新索引、-u 升级）。Arch 没有独立的 upgrade 命令。',
  },
  {
    q: '在 Rocky Linux（Red Hat 系）上安装 nginx',
    accept: ['dnf install nginx'],
    explain: 'Rocky 用 dnf：sudo dnf install nginx。RHEL 系的企业环境里这条命令最常见。',
  },
  {
    q: '在 Arch 上从 AUR 安装 google-chrome（AUR 工具用 yay，它同时支持 pacman 和 AUR）',
    accept: ['yay -s google-chrome', 'yay -syu google-chrome', 'paru -s google-chrome'],
    explain: 'AUR 是 Arch 的社区仓库，工具 yay（或 paru）：yay -S google-chrome。yay 完全兼容 pacman 的命令写法。',
  },
  {
    q: '在 Fedora 上卸载 vim',
    accept: ['dnf remove vim'],
    explain: '卸载用 remove：sudo dnf remove vim。三个派系卸载语义相同：apt remove / pacman -R / dnf remove。',
  },
  {
    q: '在 Linux Mint 上卸载 firefox',
    accept: ['apt remove firefox'],
    explain: 'Mint 基于 Ubuntu，同样用 apt：sudo apt remove firefox。记住：发行版可以千变万化，认准「派系」就能猜到命令。',
  },
  {
    q: '哪条命令是「跨发行版通用」的安装方式？（Flatpak 或 Snap 二选一，包名随便写一个）',
    accept: ['flatpak install vlc', 'flatpak install org.videolan.vlc', 'snap install vlc', 'snap install firefox'],
    explain: 'Flatpak 和 Snap 都跨发行版通用：flatpak install 包名 或 snap install 包名。这就是「一样的命令」——换哪个发行版写法都不变。',
  },
  {
    q: '在 Arch 上列出所有已安装的包',
    accept: ['pacman -q'],
    explain: 'pacman -Q 列出已安装包。注意：apt 是 apt list --installed，dnf 是 dnf list installed——三条命令各不相同。',
  },
  {
    q: '在 Ubuntu 上把所有已安装软件升级到新版本（不是只刷新索引）',
    accept: ['apt upgrade', 'apt full-upgrade', 'apt dist-upgrade'],
    explain: 'sudo apt upgrade 升级已装软件。习惯流程是：先 apt update 再 apt upgrade，两条连着用。',
  },
  {
    q: 'dnf 属于哪个派系？（输入 debian / arch / redhat 之一）',
    accept: ['redhat', 'red-hat', 'red hat'],
    explain: 'dnf 属于 Red Hat 系（Fedora、RHEL、Rocky）。yum 是它的老名字，现在大部分发行版已换成 dnf。',
  },
  {
    q: 'pacman 属于哪个派系？（输入 debian / arch / redhat 之一）',
    accept: ['arch'],
    explain: 'pacman 属于 Arch 系。注意：Manjaro 也属于 Arch 系，但它的软件更新比 Arch 慢几周，更保守。',
  },
];

// 派系对照表（静态展示 + 答错提示复用）
const table = [
  { op: '安装', debian: 'sudo apt install 包', arch: 'sudo pacman -S 包', redhat: 'sudo dnf install 包' },
  { op: '卸载', debian: 'sudo apt remove 包', arch: 'sudo pacman -R 包', redhat: 'sudo dnf remove 包' },
  { op: '搜索', debian: 'apt search 关键词', arch: 'pacman -Ss 关键词', redhat: 'dnf search 关键词' },
  { op: '刷新索引', debian: 'sudo apt update', arch: 'pacman -Sy（一般随 -Syu）', redhat: 'sudo dnf check-update' },
  { op: '升级系统', debian: 'sudo apt upgrade', arch: 'sudo pacman -Syu', redhat: 'sudo dnf upgrade' },
  { op: '已装列表', debian: 'apt list --installed', arch: 'pacman -Q', redhat: 'dnf list installed' },
];
---
<BaseLayout
  title="包管理器命令行小游戏：apt / pacman / dnf 三派系闯关 | TuxAI"
  description="终端风格小游戏：15 道命令闯关题，一次讲清 Debian 系（apt）、Arch 系（pacman）、Red Hat 系（dnf）的安装、卸载、搜索、升级命令，以及跨发行版通用的 Flatpak / Snap。"
>
  <PageHeader
    breadcrumb="游戏"
    title="包管理器命令行小游戏"
    subtitle="在终端里输入命令，挑战 15 道题。玩完你会发现：三个派系的命令长得不一样，但逻辑完全一样——install 装、remove 卸、update 刷、upgrade 升。"
  />

  <div class="max-w-3xl mx-auto px-4 py-12">
    <!-- 终端窗口 -->
    <div class="rounded-xl overflow-hidden border border-gray-800 bg-[#0d1117] shadow-lg">
      <div class="flex items-center gap-2 px-4 py-2.5 bg-[#161b22] border-b border-gray-800">
        <span class="h-3 w-3 rounded-full bg-red-500" aria-hidden="true" />
        <span class="h-3 w-3 rounded-full bg-yellow-500" aria-hidden="true" />
        <span class="h-3 w-3 rounded-full bg-green-500" aria-hidden="true" />
        <span class="ml-2 text-xs text-gray-400 font-mono">user@tuxai — 包管理器教学终端</span>
      </div>

      <div class="px-4 py-4 font-mono text-sm md:text-[15px] leading-relaxed">
        <div id="game-output" class="min-h-[260px] space-y-1.5 text-gray-300" aria-live="polite">
          <p><span class="text-green-400">tuxai</span><span class="text-gray-500">@</span><span class="text-cyan-400">linux</span><span class="text-gray-500">:~$</span> <span class="text-gray-100">echo 欢迎来到包管理器闯关！</span></p>
          <p class="text-gray-400">欢迎！一共 15 题，答对 +10 分，答错会给出正确答案和讲解。</p>
          <p class="text-gray-400">提示：命令可以带 sudo 或不带；有的答案不只一个，都算对。</p>
        </div>
        <div class="flex items-center gap-2 mt-2">
          <span class="text-green-400 shrink-0"><span class="text-gray-500">tuxai@</span>linux<span class="text-gray-500">:~$</span></span>
          <input
            id="game-input"
            type="text"
            autocomplete="off"
            spellcheck="false"
            aria-label="输入命令"
            class="flex-1 bg-transparent outline-none text-gray-100 placeholder-gray-500 font-mono"
            placeholder="输入命令后回车…"
          />
          <span class="w-2 h-4 bg-green-400 animate-pulse shrink-0" aria-hidden="true" />
        </div>
      </div>
    </div>

    <!-- 计分条 -->
    <div class="mt-4 flex items-center justify-between text-sm text-gray-600" aria-live="polite">
      <span id="game-score">得分：0</span>
      <span id="game-progress">第 1 / 15 题</span>
      <button id="game-reset" class="rounded-lg border border-gray-300 px-3 py-1.5 text-xs font-medium hover:bg-gray-100 transition-colors">
        重新开始
      </button>
    </div>
    <div class="mt-2 h-1.5 rounded-full bg-gray-200 overflow-hidden">
      <div id="game-bar" class="h-full bg-green-500 transition-all duration-300" style="width: 0%" />
    </div>

    <!-- 派系对照表 -->
    <section class="mt-12" aria-labelledby="table-title">
      <h2 id="table-title" class="text-2xl font-bold mb-2">三派系命令对照表</h2>
      <p class="text-gray-600 text-sm mb-4">记住一句话：<strong>派系决定命令</strong>。发行版可以换，认准它属于哪个派系，命令就八九不离十。</p>
      <div class="overflow-x-auto rounded-xl border border-gray-200">
        <table class="w-full text-sm text-left">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th scope="col" class="px-4 py-3 font-semibold">操作</th>
              <th scope="col" class="px-4 py-3 font-semibold">Debian 系（Debian / Ubuntu / Mint）<br /><span class="font-normal text-gray-500">apt</span></th>
              <th scope="col" class="px-4 py-3 font-semibold">Arch 系（Arch / Manjaro）<br /><span class="font-normal text-gray-500">pacman</span></th>
              <th scope="col" class="px-4 py-3 font-semibold">Red Hat 系（Fedora / RHEL / Rocky）<br /><span class="font-normal text-gray-500">dnf（旧 yum）</span></th>
            </tr>
          </thead>
          <tbody>
            {table.map((r, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50/50'}>
                <th scope="row" class="px-4 py-3 font-medium whitespace-nowrap">{r.op}</th>
                <td class="px-4 py-3 font-mono text-[13px]">{r.debian}</td>
                <td class="px-4 py-3 font-mono text-[13px]">{r.arch}</td>
                <td class="px-4 py-3 font-mono text-[13px]">{r.redhat}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 通用命令 -->
    <section class="mt-10 rounded-xl border border-gray-200 bg-white p-6" aria-labelledby="common-title">
      <h2 id="common-title" class="text-xl font-bold mb-3">有没有「一样的命令」？有</h2>
      <p class="text-gray-700 leading-relaxed mb-4">
        三个派系的命令各不相同，但有三种方式<strong>在所有发行版上写法完全一样</strong>：
      </p>
      <ul class="space-y-3 text-gray-700 text-sm leading-relaxed">
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
          <span><strong>Flatpak / Snap</strong>：<code class="font-mono bg-gray-100 rounded px-1.5 py-0.5">flatpak install 包</code>、<code class="font-mono bg-gray-100 rounded px-1.5 py-0.5">snap install 包</code>，Ubuntu、Fedora、Arch 上都能用，写法不变</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
          <span><strong>命令结构相同</strong>：全是「包管理器 + 动词」——install（装）、remove（卸）、search（搜）、update/upgrade（升级）。记住逻辑，换发行版只是换单词</span>
        </li>
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary" />
          <span><strong>sudo 前缀通用</strong>：涉及系统级操作一律加 <code class="font-mono bg-gray-100 rounded px-1.5 py-0.5">sudo</code>，三个派系都一样</span>
        </li>
      </ul>
      <p class="mt-4 text-xs text-gray-500">
        补充：AUR 是 Arch 系的社区仓库，用 yay / paru 访问，命令写法兼容 pacman。Snap 在 Ubuntu 上开箱即用，其他发行版需自行安装。
      </p>
    </section>

    <p class="mt-8 text-sm text-gray-500">
      命令因发行版版本可能略有差异，以你使用的发行版官方文档为准。玩完还想学？去<a href="/tutorials" class="text-primary no-underline hover:underline">教程库</a>看看。
    </p>
  </div>
</BaseLayout>

<script define:vars={{ questions }}>
  const output = document.getElementById('game-output');
  const input = document.getElementById('game-input');
  const scoreEl = document.getElementById('game-score');
  const progressEl = document.getElementById('game-progress');
  const barEl = document.getElementById('game-bar');
  const resetBtn = document.getElementById('game-reset');

  let idx = 0;
  let score = 0;
  let done = false;

  function normalize(cmd) {
    return cmd
      .toLowerCase()
      .replace(/^sudo\s+/, '')
      .replace(/\s+-y\b/g, '')
      .replace(/\s+--yes\b/g, '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function print(html) {
    const p = document.createElement('p');
    p.innerHTML = html;
    output.appendChild(p);
    output.scrollTop = output.scrollHeight;
  }

  function printInput(cmd) {
    print(`<span class="text-green-400">tuxai</span><span class="text-gray-500">@</span><span class="text-cyan-400">linux</span><span class="text-gray-500">:~$</span> <span class="text-gray-100">${escapeHtml(cmd)}</span>`);
  }

  function escapeHtml(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function ask() {
    if (idx >= questions.length) {
      done = true;
      input.disabled = true;
      const ratio = score / (questions.length * 10);
      const rank = ratio >= 0.9 ? '🏆 包管理器大师' : ratio >= 0.6 ? '🎖 派系通晓' : ratio >= 0.3 ? '📖 入门学徒' : '🧭 建议先看对照表';
      print(`<span class="text-green-400">—— 闯关完成 ——</span>`);
      print(`<span class="text-gray-100">最终得分：${score} / ${questions.length * 10}，称号：${rank}</span>`);
      print(`<span class="text-gray-400">三种派系命令都写在下方对照表里，收藏随时查。</span>`);
      return;
    }
    const q = questions[idx];
    print(`<span class="text-yellow-300">Q${idx + 1}. ${escapeHtml(q.q)}</span>`);
    updateHud();
  }

  function updateHud() {
    scoreEl.textContent = `得分：${score}`;
    progressEl.textContent = `第 ${Math.min(idx + 1, questions.length)} / ${questions.length} 题`;
    barEl.style.width = `${(Math.min(idx, questions.length - 1) / questions.length) * 100}%`;
  }

  function submit(cmd) {
    printInput(cmd);
    const q = questions[idx];
    const ok = q.accept.includes(normalize(cmd));
    if (ok) {
      score += 10;
      print(`<span class="text-green-400">✔ 正确 +10（当前 ${score} 分）</span>`);
    } else {
      print(`<span class="text-red-400">✘ 不对。正确答案：<span class="text-green-300">${escapeHtml(q.accept[0])}</span></span>`);
      print(`<span class="text-gray-400">${escapeHtml(q.explain)}</span>`);
    }
    idx++;
    ask();
  }

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && input.value.trim()) {
      submit(input.value.trim());
      input.value = '';
    }
  });

  resetBtn.addEventListener('click', () => {
    idx = 0;
    score = 0;
    done = false;
    input.disabled = false;
    output.innerHTML = '';
    print(`<span class="text-gray-100">已重新开始，共 ${questions.length} 题。</span>`);
    ask();
    input.focus();
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && done) e.preventDefault();
  });

  ask();
  input.focus();
</script>