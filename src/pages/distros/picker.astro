---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';

const distroMeta = {
  ubuntu: {
    name: 'Ubuntu',
    url: '/distros#ubuntu',
    desc: '最流行、生态最全，AI 工具官方支持最好',
  },
  mint: {
    name: 'Linux Mint',
    url: '/distros#mint',
    desc: '桌面最接近 Windows，迁移适应成本最低',
  },
  fedora: {
    name: 'Fedora',
    url: '/distros#fedora',
    desc: '技术新、内核新，适合开发者尝鲜',
  },
  arch: {
    name: 'Arch Linux',
    url: '/distros#arch',
    desc: '滚动更新、完全掌控，需要投入学习时间',
  },
  debian: {
    name: 'Debian',
    url: '/distros#debian',
    desc: '极致稳定，装一次用很多年',
  },
  rocky: {
    name: 'Rocky Linux',
    url: '/distros#rocky',
    desc: '服务器与企业环境，与 RHEL 兼容',
  },
};
---
<BaseLayout
  title="发行版选择器：5 个问题找到适合你的 Linux | TuxAI"
  description="回答 5 个小问题，从 Ubuntu、Linux Mint、Fedora、Arch、Debian、Rocky 中找到适合你的发行版。"
>
  <PageHeader
    breadcrumb="发行版"
    title="发行版选择器"
    subtitle="回答五个小问题，帮你缩小选择范围。没有绝对最好的发行版，只有最适合你的。"
  />

  <div class="max-w-3xl mx-auto px-4 py-12">
    <form id="picker" class="space-y-8" data-picker>
      <fieldset class="rounded-xl border border-gray-200 bg-white p-6">
        <legend class="font-semibold text-gray-900 px-1">1. 你主要想用它做什么？</legend>
        <div class="mt-4 space-y-3">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="purpose" value="desktop" class="mt-1 accent-blue-600" />
            <span><strong>日常桌面使用</strong><span class="block text-sm text-gray-600">上网、办公、影音，希望开箱即用</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="purpose" value="dev" class="mt-1 accent-blue-600" />
            <span><strong>开发 / 写代码</strong><span class="block text-sm text-gray-600">命令行、Docker、开发工具链</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="purpose" value="ai" class="mt-1 accent-blue-600" />
            <span><strong>AI 部署实践</strong><span class="block text-sm text-gray-600">本地跑大模型、Stable Diffusion、GPU 推理</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="purpose" value="server" class="mt-1 accent-blue-600" />
            <span><strong>服务器 / 学习运维</strong><span class="block text-sm text-gray-600">长期稳定运行的服务</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="purpose" value="gaming" class="mt-1 accent-blue-600" />
            <span><strong class="text-red-600">以玩游戏为主</strong><span class="block text-sm text-gray-600">反作弊与部分游戏不兼容 Linux，建议先看提醒</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="purpose" value="old" class="mt-1 accent-blue-600" />
            <span><strong>老电脑焕发新生</strong><span class="block text-sm text-gray-600">配置较低，希望流畅运行</span></span>
          </label>
        </div>
      </fieldset>

      <fieldset class="rounded-xl border border-gray-200 bg-white p-6">
        <legend class="font-semibold text-gray-900 px-1">2. 你的经验水平？</legend>
        <div class="mt-4 space-y-3">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="experience" value="new" class="mt-1 accent-blue-600" />
            <span><strong>完全新手</strong><span class="block text-sm text-gray-600">第一次接触 Linux，希望少踩坑</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="experience" value="some" class="mt-1 accent-blue-600" />
            <span><strong>用过但不多</strong><span class="block text-sm text-gray-600">玩过虚拟机或命令行，想认真用起来</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="experience" value="expert" class="mt-1 accent-blue-600" />
            <span><strong>熟悉 Linux</strong><span class="block text-sm text-gray-600">能自己处理配置问题，喜欢折腾</span></span>
          </label>
        </div>
      </fieldset>

      <fieldset class="rounded-xl border border-gray-200 bg-white p-6">
        <legend class="font-semibold text-gray-900 px-1">3. 你更看重什么？</legend>
        <div class="mt-4 space-y-3">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="preference" value="stable" class="mt-1 accent-blue-600" />
            <span><strong>稳定省心</strong><span class="block text-sm text-gray-600">软件版本旧一点没关系，别出问题</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="preference" value="new" class="mt-1 accent-blue-600" />
            <span><strong>追新</strong><span class="block text-sm text-gray-600">想第一时间用上新内核、新工具</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="preference" value="control" class="mt-1 accent-blue-600" />
            <span><strong>掌控一切</strong><span class="block text-sm text-gray-600">系统由我组装，装什么我说了算</span></span>
          </label>
        </div>
      </fieldset>

      <fieldset class="rounded-xl border border-gray-200 bg-white p-6">
        <legend class="font-semibold text-gray-900 px-1">4. 你的电脑显卡是什么情况？</legend>
        <div class="mt-4 space-y-3">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="gpu" value="integrated" class="mt-1 accent-blue-600" />
            <span><strong>集成显卡（或不确定）</strong><span class="block text-sm text-gray-600">办公上网足够，不跑大型 AI 模型</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="gpu" value="nvidia" class="mt-1 accent-blue-600" />
            <span><strong>NVIDIA 独立显卡</strong><span class="block text-sm text-gray-600">CUDA 生态，AI 推理主流选择</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="gpu" value="amd" class="mt-1 accent-blue-600" />
            <span><strong>AMD 独立显卡</strong><span class="block text-sm text-gray-600">开源驱动，Linux 下开箱即用</span></span>
          </label>
        </div>
      </fieldset>

      <fieldset class="rounded-xl border border-gray-200 bg-white p-6">
        <legend class="font-semibold text-gray-900 px-1">5. 你之前主要用什么系统？</legend>
        <div class="mt-4 space-y-3">
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="origin" value="windows" class="mt-1 accent-blue-600" />
            <span><strong>Windows</strong><span class="block text-sm text-gray-600">习惯了开始菜单、右键和图形安装包</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="origin" value="mac" class="mt-1 accent-blue-600" />
            <span><strong>macOS</strong><span class="block text-sm text-gray-600">熟悉终端和类 Unix 环境</span></span>
          </label>
          <label class="flex items-start gap-3 cursor-pointer">
            <input type="radio" name="origin" value="none" class="mt-1 accent-blue-600" />
            <span><strong>几乎没接触过其他系统</strong><span class="block text-sm text-gray-600">手机用得多，电脑用得少</span></span>
          </label>
        </div>
      </fieldset>

      <div class="flex flex-col sm:flex-row gap-3">
        <button type="submit" class="rounded-lg bg-primary px-6 py-3 font-medium text-white hover:bg-primary/90 transition-colors">
          查看推荐
        </button>
        <button type="reset" class="rounded-lg border border-gray-300 px-6 py-3 font-medium text-gray-700 hover:bg-gray-100 transition-colors">
          重新选择
        </button>
      </div>
    </form>

    <div id="result" class="mt-10 hidden" aria-live="polite" data-result></div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ distroMeta }}>
  const weights = {
    purpose: {
      desktop: { mint: 2, ubuntu: 1, fedora: 1, debian: 1, arch: 0, rocky: 0 },
      dev: { ubuntu: 2, arch: 2, fedora: 1, debian: 1, mint: 0, rocky: 0 },
      ai: { ubuntu: 3, fedora: 1, arch: 1, mint: 0, debian: 0, rocky: 0 },
      server: { debian: 2, rocky: 2, ubuntu: 1, mint: 0, fedora: 0, arch: -1 },
      old: { mint: 2, debian: 1, ubuntu: 1, fedora: 0, rocky: 0, arch: -1 },
    },
    experience: {
      new: { mint: 2, ubuntu: 1, debian: 0, fedora: 0, rocky: -1, arch: -2 },
      some: { ubuntu: 1, fedora: 1, mint: 1, debian: 0, arch: 0, rocky: 0 },
      expert: { arch: 2, debian: 1, fedora: 1, rocky: 1, ubuntu: 0, mint: -1 },
    },
    preference: {
      stable: { debian: 2, mint: 1, rocky: 1, ubuntu: 1, fedora: -1, arch: -2 },
      new: { fedora: 2, arch: 1, ubuntu: 0, rocky: 0, mint: -1, debian: -1 },
      control: { arch: 2, debian: 1, fedora: 0, rocky: 0, ubuntu: -1, mint: -1 },
    },
    gpu: {
      integrated: { ubuntu: 0, mint: 0, fedora: 0, arch: 0, debian: 0, rocky: 0 },
      nvidia: { ubuntu: 2, mint: 1, fedora: 0, rocky: 0, debian: -1, arch: -1 },
      amd: { fedora: 1, ubuntu: 1, mint: 0, arch: 0, debian: 0, rocky: 0 },
    },
    origin: {
      windows: { mint: 2, ubuntu: 1, debian: 0, fedora: 0, rocky: -1, arch: -1 },
      mac: { ubuntu: 1, fedora: 1, arch: 1, mint: 0, debian: 0, rocky: 0 },
      none: { mint: 2, ubuntu: 1, debian: 1, fedora: 0, rocky: 0, arch: -1 },
    },
  };
  const order = ['ubuntu', 'mint', 'fedora', 'arch', 'debian', 'rocky'];
  const meta = distroMeta;
  const form = document.querySelector('[data-picker]');
  const result = document.querySelector('[data-result]');
  if (form && result) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const answers = { purpose: fd.get('purpose'), experience: fd.get('experience'), preference: fd.get('preference'), gpu: fd.get('gpu'), origin: fd.get('origin') };
      if (Object.values(answers).some((v) => !v)) {
        result.innerHTML = '<p class="rounded-lg bg-amber-50 border border-amber-200 text-amber-800 p-4 text-sm">请先完成五个问题的选择。</p>';
        result.classList.remove('hidden');
        return;
      }
      if (answers.purpose === 'gaming') {
        result.innerHTML =
          `<div class="rounded-xl border-2 border-red-300 bg-red-50 p-6 md:p-8">` +
          `<p class="text-sm font-medium text-red-700 mb-2">🚫 暂时不建议换 Linux</p>` +
          `<h2 class="text-2xl font-bold text-red-900 mb-3">以打游戏为主，先别换</h2>` +
          `<ul class="space-y-2 text-sm text-red-800 mb-4 list-disc list-inside">` +
          `<li>部分竞技网游使用内核级反作弊，明确不支持 Linux</li>` +
          `<li>Proton 兼容层能玩很多 Steam 游戏，但存在性能与联机差异</li>` +
          `<li>游戏外设控制软件大多只有 Windows 版</li>` +
          `</ul>` +
          `<a href="/not-for-you" class="inline-block rounded-lg bg-red-600 px-5 py-2.5 font-medium text-white no-underline hover:bg-red-700 transition-colors">查看完整「不适合 Linux 人群」清单</a>` +
          `</div>`;
        result.classList.remove('hidden');
        result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
      }
      const scores = {};
      for (const key of order) scores[key] = 0;
      for (const [dim, answer] of Object.entries(answers)) {
        const dimW = weights[dim]?.[answer];
        if (!dimW) continue;
        for (const key of order) scores[key] += dimW[key] ?? 0;
      }
      const ranked = order.slice().sort((a, b) => scores[b] - scores[a]);
      const top = ranked[0];
      const runnerUp = ranked.find((k) => k !== top && scores[k] === scores[top]) ?? ranked[1];
      const d = meta[top];
      const r = meta[runnerUp];
      if (!d) {
        result.innerHTML = '<p class="rounded-lg bg-amber-50 border border-amber-200 text-amber-800 p-4 text-sm">暂时没有匹配结果，建议从 Ubuntu 开始。</p>';
        result.classList.remove('hidden');
        return;
      }
      const tieNote = scores[runnerUp] === scores[top]
        ? `<p class="text-sm text-gray-600 mb-4">「${r.name}」和它得分相同，看个人喜好即可。</p>`
        : `<p class="text-sm text-gray-600 mb-4">备选：<a href="${r.url}" class="underline">${r.name}</a>（紧随其后）。</p>`;
      result.innerHTML =
        `<div class="rounded-xl border border-gray-200 bg-white p-6 md:p-8">` +
        `<p class="text-sm text-gray-500 mb-2">根据你的回答，推荐：</p>` +
        `<h2 class="text-2xl font-bold text-gray-900 mb-2">${d.name}</h2>` +
        `<p class="text-gray-600 mb-2">${d.desc}</p>` +
        tieNote +
        `<a href="${d.url}" class="inline-block rounded-lg bg-primary px-5 py-2.5 font-medium text-white no-underline hover:bg-primary/90 transition-colors">了解 ${d.name} 更多</a>` +
        `</div>`;
      result.classList.remove('hidden');
      result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    form.addEventListener('reset', () => {
      result.classList.add('hidden');
      result.innerHTML = '';
    });
  }
</script>