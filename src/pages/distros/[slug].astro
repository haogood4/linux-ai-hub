---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import RiskNotice from '@/components/RiskNotice.astro';

export async function getStaticPaths() {
  const distros = await getCollection('distros');
  return distros.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}

const { d } = Astro.props;
const { Content } = await render(d);

const familyMeta = {
  debian: { label: 'Debian 系（apt）', game: '/terminal-game/debian', gameName: 'Debian 系小游戏' },
  arch: { label: 'Arch 系（pacman）', game: '/terminal-game/arch', gameName: 'Arch 系小游戏' },
  redhat: { label: 'Red Hat 系（dnf）', game: '/terminal-game/redhat', gameName: 'Red Hat 系小游戏' },
};
const fm = familyMeta[d.data.family];

const all = (await getCollection('distros')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'zh'));
const i = all.findIndex((x) => x.slug === d.slug);
const prev = all[(i - 1 + all.length) % all.length];
const next = all[(i + 1) % all.length];

const details = [
  ['上手难度', d.data.difficulty],
  ['桌面环境', d.data.desktop],
  ['稳定性', d.data.stability],
  ['更新频率', d.data.updateCycle],
  ['支持周期', d.data.supportCycle],
  ['最低配置', d.data.requirements],
];
---
<BaseLayout
  title={`${d.data.name} 安装与使用指南 | TuxAI`}
  description={`${d.data.name}（${d.data.tagline}）：系统要求、下载安装步骤、首次启动清单、常用命令速查、常见问题与官方资源。`}
>
  <div class="max-w-4xl mx-auto px-4 py-10">
    <nav class="text-sm text-gray-500 mb-4" aria-label="面包屑">
      <a href="/distros" class="hover:text-primary no-underline">发行版推荐</a>
      <span class="mx-2">/</span>
      <span class="text-gray-800">{d.data.name}</span>
    </nav>

    <header class="mb-6">
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <h1 class="text-3xl font-bold text-gray-900">{d.data.name} 完整指南</h1>
        <a href={fm.game} class="rounded-full bg-gray-900 text-white px-3 py-1 text-xs font-medium no-underline hover:bg-gray-700 transition-colors">
          {fm.label} · 🎮 去玩{fm.gameName}
        </a>
      </div>
      <p class="text-lg text-gray-600">{d.data.tagline}</p>
    </header>

    <section class="mb-8 rounded-xl border border-gray-200 bg-white p-6">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">快速档案</h2>
      <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-3 text-sm">
        {details.map(([k, v]) => (
          <div>
            <dt class="text-gray-500 inline">{k}：</dt>
            <dd class="inline text-gray-800">{v}</dd>
          </div>
        ))}
      </dl>
      <div class="flex flex-wrap gap-3 mt-6">
        <a href={d.data.officialUrl} target="_blank" rel="noopener noreferrer" class="inline-block rounded-lg bg-primary px-4 py-2 text-sm font-medium text-white no-underline hover:bg-primary/90 transition-colors">
          官网下载
        </a>
        <a href={d.data.installGuideUrl} target="_blank" rel="noopener noreferrer" class="inline-block rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 no-underline hover:bg-gray-50 transition-colors">
          官方安装文档
        </a>
      </div>
    </section>

    <div class="mb-8"><RiskNotice /></div>

    <article class="prose prose-gray max-w-none prose-headings:font-bold prose-h2:mt-10 prose-h2:mb-3 prose-h3:mt-6 prose-a:text-primary">
      <Content />
    </article>

    <section class="mt-12 rounded-xl bg-gray-900 text-white p-6 md:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-lg font-bold mb-1">边玩边记命令</h2>
        <p class="text-sm text-gray-300">在「{fm.gameName}」里回答 10 道题，把 {fm.label} 常用命令练成本能。</p>
      </div>
      <a href={fm.game} class="shrink-0 rounded-lg bg-primary px-5 py-2.5 font-medium text-white no-underline hover:bg-primary/90 transition-colors">
        🎮 开始练习
      </a>
    </section>

    <section class="mt-8 rounded-xl border border-gray-200 bg-white p-6">
      <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide mb-4">官方资源与社区</h2>
      <ul class="text-sm space-y-2">
        <li><a href={d.data.officialUrl} target="_blank" rel="noopener noreferrer" class="text-primary no-underline hover:underline">官网下载页</a></li>
        <li><a href={d.data.installGuideUrl} target="_blank" rel="noopener noreferrer" class="text-primary no-underline hover:underline">官方安装文档</a></li>
        {d.data.wikiUrl && <li><a href={d.data.wikiUrl} target="_blank" rel="noopener noreferrer" class="text-primary no-underline hover:underline">官方 Wiki / 文档</a></li>}
        {d.data.communityUrl && <li><a href={d.data.communityUrl} target="_blank" rel="noopener noreferrer" class="text-primary no-underline hover:underline">社区论坛</a></li>}
      </ul>
    </section>

    <nav class="mt-10 flex justify-between text-sm" aria-label="其他发行版">
      <a href={`/distros/${prev.slug}`} class="text-gray-600 no-underline hover:text-primary">← {prev.data.name}</a>
      <a href="/distros" class="text-gray-500 no-underline hover:text-primary">全部发行版</a>
      <a href={`/distros/${next.slug}`} class="text-gray-600 no-underline hover:text-primary">{next.data.name} →</a>
    </nav>
  </div>
</BaseLayout>