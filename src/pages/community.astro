---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';

const communities = [
  {
    title: '中文社区',
    items: [
      { name: 'Ubuntu 中文论坛', href: 'https://forum.ubuntu.com.cn/', note: '中文用户最活跃的 Linux 论坛之一，新手问题基本都能找到答案' },
      { name: 'Arch Linux 中文社区', href: 'https://bbs.archlinuxcn.org/', note: 'Arch 用户中文交流与求助（Arch 中文 wiki 也值得收藏）' },
      { name: '各发行版官方中文文档', href: 'https://wiki.ubuntu.org.cn/', note: 'Ubuntu 中文 Wiki，覆盖安装、配置、故障排查' },
    ],
  },
  {
    title: '英文社区（资料更全）',
    items: [
      { name: 'Reddit r/linux', href: 'https://www.reddit.com/r/linux/', note: '全球最大的 Linux 讨论社区，新闻、求助、晒桌面（国内访问需代理）' },
      { name: 'Reddit r/Ubuntu / r/Fedora 等', href: 'https://www.reddit.com/r/Ubuntu/', note: '各发行版子版块，提问时注明发行版更容易得到精确回答（国内访问需代理）' },
      { name: 'Unix & Linux Stack Exchange', href: 'https://unix.stackexchange.com/', note: '高质量问答，适合「为什么」类问题，回答通常有依据' },
    ],
  },
  {
    title: '提问之前',
    items: [
      { name: '先搜索', href: '/faq', note: '80% 的问题在搜索引擎、官方文档和 FAQ 里已有答案' },
      { name: '提供环境信息', href: '', note: '说明发行版、版本号、硬件（lspci 输出）和完整报错信息' },
      { name: '贴出日志', href: '', note: '日志是排查问题的关键，如 journalctl -xe 的输出' },
    ],
  },
];
---
<BaseLayout
  title="社区入口：到哪里提问、交流和获取帮助 | TuxAI"
  description="Linux 中文与英文社区导航：Ubuntu 中文论坛、Reddit、Unix & Linux Stack Exchange，以及高效的提问方法。"
>
  <PageHeader
    breadcrumb="社区"
    title="社区入口"
    subtitle="Linux 的力量很大一部分来自社区。遇到问题、想找同好、想深入学习，都可以从这些地方开始。"
  />

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="space-y-10">
      {communities.map((c) => (
        <section>
          <h2 class="text-2xl font-bold mb-4">{c.title}</h2>
          <div class="space-y-3">
            {c.items.map((item) => (
              <div class="rounded-xl border border-gray-200 bg-white p-5">
                {item.href ? (
                  <a href={item.href} target="_blank" rel="noopener noreferrer" class="font-medium text-primary hover:underline no-underline">
                    {item.name} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <p class="font-medium text-gray-900">{item.name}</p>
                )}
                <p class="mt-1 text-sm text-gray-600">{item.note}</p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>

    <p class="mt-10 text-sm text-gray-500">
      提示：以上为公开社区链接，外部网站内容与本站无关。在社区提问时请注意保护个人隐私，不要泄露密码或密钥。
    </p>
  </div>
</BaseLayout>