---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, tags, date, author } = post.data;
---
<BaseLayout
  title={`${title} | TuxAI`}
  description={`${post.data.excerpt}`}
>
  <article class="max-w-3xl mx-auto px-4 py-12">
    <nav aria-label="面包屑" class="text-sm text-gray-500 mb-4">
      <a href="/" class="hover:text-primary no-underline">首页</a>
      <span aria-hidden="true"> / </span>
      <a href="/blog" class="hover:text-primary no-underline">博客</a>
      <span aria-hidden="true"> / </span>
      <span class="text-gray-700">{title}</span>
    </nav>

    <header class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 leading-tight mb-4">{title}</h1>
      <p class="text-xs text-gray-500 mb-4">
        {author} · {date.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="rounded-full bg-gray-100 text-gray-600 px-2.5 py-0.5 text-xs">{tag}</span>
        ))}
      </div>
    </header>

    <div class="prose-linux">
      <Content />
    </div>

    <nav aria-label="页尾导航" class="mt-12 border-t border-gray-200 pt-6">
      <a href="/blog" class="inline-block rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-medium text-gray-700 no-underline hover:bg-gray-100 transition-colors">
        ← 返回博客
      </a>
    </nav>
  </article>
</BaseLayout>