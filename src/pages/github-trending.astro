---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';

const today = new Date();
const weekAgo = new Date(Date.now() - 7 * 864e5).toISOString().slice(0, 10);
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'GitHub 每日动态 — TuxAI',
  url: 'https://tuxai.cn/github-trending',
  inLanguage: 'zh-CN',
  description: '每日实时更新的 GitHub 热门仓库动态：最近一周新建的高星项目、热门语言趋势。',
});
---
<BaseLayout
  title="GitHub 每日动态 — TuxAI"
  description="每日实时更新的 GitHub 热门仓库动态：最近一周新建的高星项目、热门语言趋势。"
  jsonLd={jsonLd}
>
  <PageHeader
    breadcrumb="GitHub 每日动态"
    title="GitHub 每日动态"
    subtitle="实时拉取 GitHub 官方 API，展示最近一周新建的明星项目。数据每日更新，无需重新部署。"
  />

  <section class="bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 py-10">
      <div class="flex items-center justify-between mb-6">
        <p class="text-sm text-gray-600" data-status aria-live="polite">加载中…</p>
        <button
          type="button"
          data-refresh
          class="rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors"
        >
          刷新
        </button>
      </div>

      <div class="space-y-4" data-list></div>

      <details class="mt-10 rounded-xl border border-gray-200 bg-white p-4">
        <summary class="cursor-pointer text-sm font-medium text-gray-700">数据来源与说明</summary>
        <p class="mt-3 text-sm text-gray-600 leading-relaxed">
          本页数据来自 GitHub 官方 <a href="https://docs.github.com/rest/search" target="_blank" rel="noopener" class="underline underline-offset-4 decoration-gray-400 hover:text-primary">Search API</a>（
          <code class="text-xs bg-gray-100 px-1 py-0.5 rounded">created:&gt;{weekAgo}&amp;sort=stars</code>
          ），即最近 7 天内创建、Star 数最高的仓库。API 未认证时限流 10 次/分钟，刷新过于频繁可能暂时失败，稍后重试即可。
        </p>
      </details>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const list = document.querySelector('[data-list]');
    const status = document.querySelector('[data-status]');
    const btn = document.querySelector('[data-refresh]');
    if (!list || !status || !btn) return;

    const langColor = {
      JavaScript: '#f1e05a', TypeScript: '#3178c6', Python: '#3572A5', Go: '#00ADD8',
      Rust: '#dea584', C: '#555555', 'C++': '#f34b7d', 'C#': '#178600', Java: '#b07219',
      Shell: '#89e051', HTML: '#e34c26', CSS: '#563d7c', Ruby: '#701516', PHP: '#4F5D95',
      Swift: '#F05138', Kotlin: '#A97BFF', Zig: '#ec915c', 'Jupyter Notebook': '#DA5B0B',
      Vue: '#41b883', Svelte: '#ff3e00', Lua: '#000080', Dart: '#00B4AB', Elixir: '#6e4a7e',
    };
    const colorFor = (l) => langColor[l] || '#8b949e';
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fmt = (n) => (n >= 1e4 ? (n / 1e3).toFixed(1) + 'k' : String(n));
    const weekAgo = new Date(Date.now() - 7 * 864e5).toISOString().slice(0, 10);

    async function load() {
      status.textContent = '加载中…';
      btn.disabled = true;
      try {
        const url = 'https://api.github.com/search/repositories' +
          '?q=created:%3E' + weekAgo + '&sort=stars&order=desc&per_page=15';
        const res = await fetch(url, { headers: { Accept: 'application/vnd.github+json' } });
        if (!res.ok) {
          if (res.status === 403) throw new Error('API 限流（10 次/分钟），请稍后再试');
          if (res.status === 422) throw new Error('没有可用的查询结果');
          throw new Error('请求失败：HTTP ' + res.status);
        }
        const data = await res.json();
        const items = data.items || [];
        if (items.length === 0) {
          status.textContent = '最近 7 天暂无新建仓库数据。';
          return;
        }
        status.textContent = `共 ${data.total_count} 个候选 · 显示 Top ${items.length}`;
        list.innerHTML = items.map((r) => `
          <article class="rounded-xl border border-gray-200 bg-white p-5">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <h2 class="font-semibold text-gray-900 mb-1">
                  <a class="no-underline hover:text-primary" href="${esc(r.html_url)}" target="_blank" rel="noopener">
                    ${esc(r.owner?.login)}<span class="text-gray-400">/</span>${esc(r.name)}
                  </a>
                </h2>
                <p class="text-sm text-gray-600 leading-relaxed">${esc(r.description || '（无描述）')}</p>
              </div>
              <div class="shrink-0 text-right">
                <p class="text-sm font-medium text-gray-900" title="Star 总数">★ ${fmt(r.stargazers_count)}</p>
                <p class="text-xs text-gray-500">${fmt(r.forks_count)} forks</p>
              </div>
            </div>
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block w-3 h-3 rounded-full" style="background:${colorFor(r.language)}"></span>
                ${esc(r.language || '—')}
              </span>
              ${r.license ? `<span>${esc(r.license.spdx_id || r.license.name || '')}</span>` : ''}
              ${r.stargazers_count > 0 ? `<span>${fmt(r.open_issues_count)} issues</span>` : ''}
              ${r.created_at ? `<span>创建于 ${r.created_at.slice(0, 10)}</span>` : ''}
            </div>
          </article>`).join('');
      } catch (e) {
        status.textContent = '加载失败：' + e.message;
        list.innerHTML = '<p class="text-sm text-gray-500">请点击「刷新」重试，或稍后再来。</p>';
      } finally {
        btn.disabled = false;
      }
    }

    btn.addEventListener('click', load);
    load();
  })();
</script>