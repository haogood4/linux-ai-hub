---
import '../styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: string;
}

const {
  title = 'TuxAI — 重新认识你的电脑，从 Linux 开始',
  description = 'TuxAI（tuxai.cn）：Linux + AI 开发者平台，面向新手的 Linux 入门指南、AI 本地部署教程与工具评测。',
  noindex = false,
  jsonLd = '',
} = Astro.props as Props;
--->
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? 'https://tuxai.cn').toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? 'https://tuxai.cn').toString()} />
    <meta property="og:site_name" content="TuxAI" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>